# .env.example — Major Explorer 项目凭据模板
#
# ⚠️ 真实凭据在 .env (已被 .gitignore 保护, 不会 commit)
# ⚠️ 复制本文件为 .env 然后填入实际值:
#     cp .env.example .env && vim .env
# ⚠️ Python 脚本必须用 `export` 才能被子进程读取
# ⚠️ 部署到 Cloudflare Pages 时, 用 `wrangler pages secret put <KEY>` 绑定, 不要提交
# ⚠️ 任何 docs/*.md / README.md 永不使用明文 token/key — GH push protection 会拒
#    如需引用, 一律用 <PLACEHOLDER> 占位 (DEEPSEEK_API_KEY, GITHUB_TOKEN, ...)

# ──────────── LLM Provider ────────────

# DeepSeek V4 Flash (缓存命中 ¥0.02/M, 未命中 ¥1/M input)
export DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>

# MiniMax M3 (token plan 套餐, 不能走按量计费 URL, 走 https://api.minimaxi.com/anthropic)
export M3_API_KEY=<M3_API_KEY>
export M3_BASE_URL=<M3_BASE_URL>
export M3_MODEL=<M3_MODEL>

# MiMo V2.5 (Xiaomi MiMo, OpenAI 兼容端点, 按量付费)
export MIMO_API_KEY=<MIMO_API_KEY>
export MIMO_BASE_URL=<MIMO_BASE_URL>
export MIMO_MODEL=<MIMO_MODEL>

# 当前 LLM provider: m3 (默认, 备选 deepseek)
export LLM_PROVIDER=m3

# ──────────── Cloudflare ────────────

# Cloudflare Account
export CF_ACCOUNT_ID=<CF_ACCOUNT_ID>

# Cloudflare API Token (cfut_ 开头, 47 字符) — 升级加 D1:Edit scope
export CF_API_TOKEN=<CF_API_TOKEN>

# Cloudflare D1 database "synth-jobs" ID
export CF_D1_DATABASE_ID=<CF_D1_DATABASE_ID>

# Cloudflare KV namespace "RATE_LIMIT_KV" ID (H 阶段, 2026-06-16 上线)
#   用途: /api/report 接口 rate limit (60s 1 次/IP, 跨 cold start 持久化)
#   创建: npx wrangler kv namespace create RATE_LIMIT_KV
#   部署: 写入 wrangler.toml 的 [[kv_namespaces]] binding
#   H12: 当前不立即启用, report.js 运行时 fallback in-memory; 启用只需把 id 填 wrangler.toml
export CF_KV_RATE_LIMIT_ID=<CF_KV_RATE_LIMIT_ID>

# ──────────── GitHub (2026-06-16 新增) ────────────

# GitHub PAT (fine-grained, 用途: /api/report Function 创建 issue)
#   scope: <your-org>/majorexplorer only
#   permission: Issues: Read and Write
#   部署时: wrangler pages secret put GITHUB_TOKEN
export GITHUB_TOKEN=<GITHUB_TOKEN>

# GitHub repo name (必填, 无默认值 — 部署前必须 set)
#   格式: <your-org>/majorexplorer
export GITHUB_REPO=<your-org>/majorexplorer
