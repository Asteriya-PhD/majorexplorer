        {
          "name": "方向 1",
          "desc": "医学检验技术是连接临床医学与实验室科学的桥梁专业，培养掌握临床检验、生化检验、免疫学检验、微生物检验及分子诊断等核心技术"
        },
        {
          "name": "方向 2",
          "desc": "毕业生主要在各级医院检验科、第三方医学检验所、体外诊断（IVD）企业从事临床检验、质量控制与实验室管理工作。"
        },
        {
          "name": "方向 3",
          "desc": "随着精准医疗和 POCT（即时检验）快速发展，该专业就业率长期稳定在 95% 以上，是医学类中少有的\"不直接面对患者但刚"
        }
      ],
      "skills": [
        "逻辑分析",
        "文献阅读",
        "独立研究",
        "专业写作"
      ]
    },
