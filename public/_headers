# Cloudflare Pages _headers
# Security headers applied to all paths. CF Pages auto-applies per route.
# See https://developers.cloudflare.com/pages/configuration/headers/

/*
  # ── MIME / XSS ────────────────────────────
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Clickjacking (legacy) ─────────────────
  X-Frame-Options: SAMEORIGIN

  # ── HSTS (1 year; preload-eligible after 60d) ──
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ── Permissions-Policy (disable high-risk APIs we don't use) ──
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), ambient-light-sensor=(), interest-cohort=()

  # ── Content-Security-Policy ───────────────
  # Notes:
  #   * 'unsafe-inline' for script-src is required because every page has
  #     <script>...</script> inline (UA sniff, inline JSON-LD, app boot).
  #     We do not use eval() anywhere. Tighten with nonces when migrating.
  #   * 'unsafe-inline' for style-src is required because the per-page
  #     theme CSS is inline (<style> in <head>).
  #   * fonts.loli.net is the only 3rd-party font source (Bohdi+Inter+JB Mono).
  #   * data: images used by favicon and noise-texture backgrounds.
  #   * Plausible analytics endpoint whitelisted in connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.loli.net; font-src 'self' https://fonts.loli.net data:; img-src 'self' data: https:; connect-src 'self' https://plausible.io https://majorexplorer.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Long-cache static assets (CSS / JS — content-hashed by version stamp)
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/data/aggregates.json
  Cache-Control: public, max-age=3600, must-revalidate
/data/manifest.json
  Cache-Control: public, max-age=600, must-revalidate

# HTML must revalidate (we want edits to take effect within ~1 min)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# robots hints
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=86400
