# Cloudflare Pages _headers
# Security headers applied to all paths. CF Pages auto-applies per route.
# See https://developers.cloudflare.com/pages/configuration/headers/

/*
  # ── MIME / XSS ────────────────────────────
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Clickjacking (legacy) ─────────────────
  X-Frame-Options: SAMEORIGIN

  # ── HSTS (1 year; preload-eligible after 60d) ──
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ── Permissions-Policy (disable high-risk APIs we don't use) ──
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), ambient-light-sensor=(), interest-cohort=()

  # ── Content-Security-Policy ───────────────
  # Notes:
  #   * 'unsafe-inline' for script-src is required because every page has
  #     <script>...</script> inline (UA sniff, inline JSON-LD, app boot).
  #     We do not use eval() anywhere. Tighten with nonces when migrating.
  #   * 'unsafe-inline' for style-src is required because the per-page
  #     theme CSS is inline (<style> in <head>).
  #   * fonts.loli.net 是主字体 CDN (Bohdi+Inter+JB Mono)
  #   * gstatic.loli.net 是 Google Fonts 镜像 (Inter 字体在某些浏览器走 gstatic 重定向)
  #   * data: images used by favicon and noise-texture backgrounds.
  #   * Plausible analytics endpoint whitelisted in connect-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.loli.net; font-src 'self' https://fonts.loli.net https://gstatic.loli.net data:; img-src 'self' data: https:; connect-src 'self' https://plausible.io https://majorexplorer.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

  # ── AI 训练 / 数据采集 UA 黑名单 ─────────────
  # robots.txt 是软协议, _headers 也无法做 UA match (Pages 不支持).
  # 三道防线 (全部启用):
  #   1) X-Robots-Tag 声明 noai, noimageai (合规爬虫会读)
  #   2) robots.txt 列出 32 个 AI 训练 UA + Disallow: /
  #   3) Cloudflare WAF 自定义规则: User-Agent 匹配 → Block
  #      启用指南见 docs/SECURITY_bot_protection.md
  X-Robots-Tag: noai, noimageai

# Honeypot 路径 — 没人会访问, 访问就 403
# (蜜饵 slug, 用来识别 naive scraper — 见 manifest_extras.json)
/data/manifest_extras.json
  X-Robots-Tag: noindex, nofollow, noai
  Content-Security-Policy: default-src 'none'
/data/_internal/*
  X-Robots-Tag: noindex, nofollow, noai
  Content-Security-Policy: default-src 'none'

# 数据 API 路径额外保护 — 静态站 JSON, 不需要长 cache
# (没有则不输出, 防止误抓)
/data/*.json
  X-Robots-Tag: noai, noimageai

# Long-cache static assets (CSS / JS — content-hashed by version stamp)
# 1h + must-revalidate: 浏览器/Etag 1h 内用 cache, 1h 后重新校验, 没改就用 304, 改了 fetch 新版。
# 牺牲一点首次加载性能, 换可维护性 — 不再需要每次手动 cache-bust (?v=)。
# 如果发现某个 commit 后 CDN 没刷, 见 docs/DEPLOY_HYBRID.md (CF API purge 备用)
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
/data/aggregates.json
  Cache-Control: public, max-age=3600, must-revalidate
/data/manifest.json
  Cache-Control: public, max-age=600, must-revalidate

# HTML must revalidate (we want edits to take effect within ~1 min)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# robots hints
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=86400
